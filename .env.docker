# Usage: docker compose --env-file .env.docker up -d --build
# LINE/LIFF values must be filled from the developer's real channel before E2E.

# Postgres
POSTGRES_DB=pawrent
POSTGRES_USER=pawrent_admin
POSTGRES_PASSWORD=pawrent_admin_dev_password
# Host port remaps — defaults (5432/3000) collide with vets-hub-db + ssh tunnel on this Mac
POSTGRES_HOST_PORT=5433
APP_HOST_PORT=3100

# App DB pools
# RLS-enforced app pool
DATABASE_URL=postgres://pawrent_app:pawrent_app_dev_password@postgres:5432/pawrent
# Service-context pool
DATABASE_ADMIN_URL=postgres://pawrent_admin:pawrent_admin_dev_password@postgres:5432/pawrent

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=pawrent
MINIO_ROOT_PASSWORD=pawrent_minio_dev
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET_PET_PHOTOS=pet-photos
S3_BUCKET_USER_PHOTOS=user-photos
S3_BUCKET_REPORT_MEDIA=report-media
S3_BUCKET_FEEDBACK_IMAGES=feedback-images
# 5th bucket — SOS voice memos (app/api/voice); lead amendment 2026-06-12
S3_BUCKET_VOICE_RECORDINGS=voice-recordings

# Auth
# Self-issued jose JWT, 1h expiry
JWT_SECRET=change-me-32-bytes-min-for-jose-hs256

# LINE
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ID=

# Build-time
# Baked into the client bundle by docker build
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron
CRON_SECRET=change-me-cron-secret

# E2E
E2E_TEST_MODE=true

# Transitional
# Keep the current pre-rewire app bootable on compose; delete after the data-layer rewire lands.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
